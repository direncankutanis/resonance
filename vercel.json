{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "output/vercel-site/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "buildCommand": "python3 integrations/web/build.py",
  "installCommand": "",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 40,
      "excludeFiles": "{output/**,contracts/**,sources/**,.private/**,**/.private/**,.env*,**/.env*,**/.vercel/**,**/test_*.py,**/check_*.py,integrations/latch/vercel/**}"
    }
  }
}
