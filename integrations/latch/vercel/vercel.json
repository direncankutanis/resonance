{
  "version": 2,
  "builds": [
    {
      "src": "api/proposals.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/proposals",
      "dest": "/api/proposals.py"
    },
    {
      "src": "/api/proposals",
      "dest": "/api/proposals.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}