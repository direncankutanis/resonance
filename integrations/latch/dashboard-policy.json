{
  "status": "Active; real proxy allow and deny verified",
  "filters": [
    {
      "type": "method",
      "name": "Proposals use POST",
      "allowed": [
        "POST"
      ]
    },
    {
      "type": "endpoint",
      "name": "Proposal endpoint only",
      "mode": "allowlist",
      "patterns": [
        "/proposals"
      ]
    },
    {
      "type": "body_size",
      "name": "Small structured proposal",
      "maxBytes": 4096
    },
    {
      "type": "payload",
      "name": "Diren practice-plan limits",
      "rules": [
        {
          "path": "$.action",
          "operator": "equals",
          "value": "buy"
        },
        {
          "path": "$.asset",
          "operator": "equals",
          "value": "DEMO"
        },
        {
          "path": "$.amountMinor",
          "operator": "type_is",
          "value": "number"
        },
        {
          "path": "$.amountMinor",
          "operator": "greater_than",
          "value": 10
        },
        {
          "path": "$.amountMinor",
          "operator": "less_than_or_equal",
          "value": 2000
        }
      ]
    },
    {
      "type": "rate_limit",
      "name": "Demo request limit",
      "maxRequests": 10,
      "windowSeconds": 60,
      "keyBy": "latch"
    }
  ],
  "dryRunObserved": {
    "valid": "allow",
    "wrongMethod": "deny",
    "wrongEndpoint": "deny",
    "oversized": "deny",
    "wrongAction": "deny"
  },
  "remaining": [
    "Live rate limit verification",
    "Application backend integration; no AI or purchases yet"
  ],
  "serverOnlyChecks": [
    "Integer amount",
    "No unexpected fields"
  ],
  "latchId": "lnk_350bc75b81e7435d",
  "customDryRuns": {
    "amountMinor2000": "allow",
    "amountMinor3000": "deny: $.amountMinor must be <= 2000"
  },
  "liveProxy": {
    "withinCap": {
      "status": 200,
      "executed": false
    },
    "overCap": {
      "status": 403,
      "deniedByPresent": true
    }
  }
}
